// A subagent's policy: `agent-roots.eyg` with an allowlist over which of its fields
// are performed at all. `eyg_subagent` installs it when a spawner names `effects`, so
// the spawner can hand a child "read and print, nothing else" without editing a file
// and without widening anything: every rule below is the agent-roots rule or a refusal,
// never a rule agent-roots does not have.
//
// Like every policy here this module exports `rules(ctx)` and performs nothing itself;
// the guard (`host/guard.eyg`) applies the record to the child's effects.
//
// ctx.fields is the allowlist the spawner named: the FIELD names (the lower-case names
// in the record at the bottom of this file) as a list of strings. An empty list names
// no field, so every field with a rule here is refused - the narrow reading of a
// missing list,
// chosen because a policy nobody configured must not be the wide one.
//
// ctx.roots works exactly as it does in `agent-roots.eyg`: a list of absolute roots,
// empty meaning none, and `.env.eyg` never readable. A field that IS in the allowlist
// is still decided by its roots, so the two lists are independent cuts and neither can
// loosen the other.
//
// Self-contained like every policy here: the rules are written out whole rather than
// imported, because a policy module may not import anything outside this package
// (`notes/pi-codemode-policy-inlining.md`), so a narrowing policy carries its base.
// The drift between the two files is a known cost, recorded in
// `notes/spawner-effect-allowlist.md`.
//
// What this policy can and cannot do, one row per field:
//
//   NAMED IN THE ALLOWLIST: THE AGENT-ROOTS RULE
//     append_file, delete_file, make_directory, read_directory, read_file, search,
//     write_file                      - named: the roots rule (read_file keeps hiding
//                                       `.env.eyg`); not named: refused
//     cwd, exit, flip, now, random, sleep, standard_error, standard_out
//                                     - named: passed as agent-roots passes it;
//                                       not named: refused
//   NEVER PERFORMED, allowlist or not
//     fetch, standard_in, create_key  - agent-roots refuses them, and an allowlist
//                                       removes reach, it does not add it. A child
//                                       cannot be given the network this way.
//   ANSWERED AS UNSET, allowlist or not
//     env                             - None({}) is the only answer the effect's own
//                                       type allows, and it reads nothing, so there
//                                       is nothing to narrow
//   NO RULE (available under every policy)
//     DecodeJSON, EYGParse, Hash, Sign - the language marks them unchecked: they
//                                       compute over values the program already
//                                       holds. Naming them in the allowlist changes
//                                       nothing and the tool says so.
//
// `search` is its own field here, so naming `read_file` lets a child read files and
// not search trees; a spawner that wants both names both. The CLI used to decide a
// search through the `read_file` field, which made the pair one field; `host/guard.eyg`
// explains why one field per effect is what the guard's own types allow. Naming one
// can never reach what the other decides.
//
// A refusal is a value, not a crash: `<field> denied by policy:
// EYG_SUBAGENT_EFFECTS=<the list the child was given>`, which is what makes the
// refusal readable to the child and to the parent that reads its records.

// Perform the effect with the value the program asked for, unchanged.
let pass = (value) -> {
  Pass(value)
}

// Refuse, with the text the program receives.
let deny = (reason) -> {
  (_) -> { Mock(reason) }
}

let append = (a, b) -> {
  !string_append(a, b)
}

let refuse = (effect) -> {
  deny(append(effect, " denied by policy"))
}

// Is the absolute path equal to or inside the absolute root.
let is_under = (root, path) -> {
  let root = match !string_ends_with(root, "/") {
    True(_) -> { root }
    False(_) -> { append(root, "/") }
  }
  match !equal(append(path, "/"), root) {
    True(_) -> { True({}) }
    False(_) -> { !string_starts_with(path, root) }
  }
}

let any_under = (roots, path) -> {
  !list_fold(roots, False({}), (root, found) -> {
    match found {
      True(_) -> { True({}) }
      False(_) -> { is_under(root, path) }
    }
  })
}

// The refusal names the effect and the path, which is what makes a denial
// readable to the program that asked.
let denied = (effect, path) -> {
  append(effect, append(" denied by policy: ", path))
}

// Allow a file effect only for paths under one of the absolute roots.
// `path_of` takes the path out of the effect's value, which differs by effect.
let under = (effect, roots, path_of) -> {
  (value) -> {
    let path = path_of(value)
    match any_under(roots, path) {
      True(_) -> { Pass(value) }
      False(_) -> { Mock(denied(effect, path)) }
    }
  }
}

// The value of DeleteFile, MakeDirectory and ReadDirectory is the path itself.
let path_of_value = (path) -> {
  path
}

// ReadFile, WriteFile, AppendFile and Search are given a record with a `path` row.
let request_path = (request) -> {
  request.path
}

// Files that hold secrets, by convention `.env.eyg`, are never readable.
let is_secret = (path) -> {
  !string_ends_with(path, ".env.eyg")
}

// Wrap a read_file rule so a secret file is refused before the root is consulted.
let hide_secrets = (read_file) -> {
  (request) -> {
    match is_secret(request.path) {
      True(_) -> { Mock(denied("read_file", request.path)) }
      False(_) -> { read_file(request) }
    }
  }
}

// Join a list back into one string, for the refusal that names the list the
// child was actually given.
let join_list = (items, separator) -> {
  !list_fold(items, "", (item, joined) -> {
    match !equal(joined, "") {
      True(_) -> { item }
      False(_) -> { append(joined, append(separator, item)) }
    }
  })
}

let named = (fields, field) -> {
  !list_fold(fields, False({}), (candidate, found) -> {
    match found {
      True(_) -> { True({}) }
      False(_) -> { !equal(candidate, field) }
    }
  })
}

// The refusal for a field the spawner did not name. It carries the list the child
// was given, so a child that asks for a field it does not have can see the whole
// boundary in the error rather than guessing at it.
let not_named = (field, fields) -> {
  deny(append(field, append(" denied by policy: EYG_SUBAGENT_EFFECTS=", join_list(fields, ","))))
}

// A path rule, or a refusal, decided by the allowlist.
let gated_under = (field, fields, roots, path_of) -> {
  match named(fields, field) {
    True(_) -> { under(field, roots, path_of) }
    False(_) -> { not_named(field, fields) }
  }
}

// A pass-through rule, or a refusal naming the list the child was given.
let gated_pass = (field, fields) -> {
  match named(fields, field) {
    True(_) -> { pass }
    False(_) -> { not_named(field, fields) }
  }
}

// read_file keeps hiding `.env.eyg` when it is named at all.
let gated_read_file = (fields, roots) -> {
  match named(fields, "read_file") {
    True(_) -> { hide_secrets(under("read_file", roots, request_path)) }
    False(_) -> { not_named("read_file", fields) }
  }
}

let rules = (ctx) -> {
  let roots = ctx.roots
  let fields = ctx.fields
  {
    append_file: gated_under("append_file", fields, roots, request_path),
    create_key: refuse("create_key"),
    cwd: gated_pass("cwd", fields),
    delete_file: gated_under("delete_file", fields, roots, path_of_value),
    env: refuse("env"),
    exit: gated_pass("exit", fields),
    fetch: refuse("fetch"),
    flip: gated_pass("flip", fields),
    make_directory: gated_under("make_directory", fields, roots, path_of_value),
    now: gated_pass("now", fields),
    random: gated_pass("random", fields),
    read_directory: gated_under("read_directory", fields, roots, path_of_value),
    read_file: gated_read_file(fields, roots),
    search: gated_under("search", fields, roots, request_path),
    sleep: gated_pass("sleep", fields),
    standard_error: gated_pass("standard_error", fields),
    standard_in: refuse("standard_in"),
    standard_out: gated_pass("standard_out", fields),
    write_file: gated_under("write_file", fields, roots, request_path)
  }
}

{rules}
