// The hidden-name rule: a path with a segment in `secret_directory_names`, or ending
// `.env.eyg`, is refused in every direction - read, listed, searched, written,
// appended, deleted - even under a root (`policies/agent-roots.eyg`, `hidden` and
// `hide_secrets`). The last two rows are the bound the rule does not cross: a
// secret-*shaped* file that is not in one of those directories and does not carry that
// name is still readable, because the rule names directories, not secrets.
//
// The caller builds the root before the run, so every refused path exists to refuse:
//   mkdir -p $root/ordinary/nested $root/secrets $root/.ssh
//   printf x > $root/ordinary/nested/file.txt
//   printf SECRET > $root/secrets/id_rsa && printf SECRET > $root/ordinary/id_rsa
//   touch $root/ordinary/secrets
//   printf 'Host x\n' > $root/.ssh/config && printf TOKEN=1 > $root/.env.eyg
let landed = (got) -> {
  match got {
    Ok(_) -> { "landed" }
    Error(reason) -> { reason }
  }
}
let read_ordinary = perform ReadFile({path: "{{root}}/ordinary/nested/file.txt", offset: 0, limit: 20})
let write_ordinary = perform WriteFile({path: "{{root}}/ordinary/nested/new.txt", contents: !string_to_binary("marker")})
let read_in_secrets = perform ReadFile({path: "{{root}}/secrets/id_rsa", offset: 0, limit: 20})
let write_in_secrets = perform WriteFile({path: "{{root}}/secrets/planted", contents: !string_to_binary("marker")})
let append_in_secrets = perform AppendFile({path: "{{root}}/secrets/id_rsa", contents: !string_to_binary("marker")})
let delete_in_secrets = perform DeleteFile("{{root}}/secrets/id_rsa")
let mkdir_in_secrets = perform MakeDirectory("{{root}}/secrets/sub")
let list_in_secrets = perform ReadDirectory("{{root}}/secrets")
let search_in_secrets = perform Search({path: "{{root}}/secrets", pattern: "**", limit: 20})
let search_from_root = perform Search({path: "{{root}}", pattern: "**", limit: 20})
let read_ssh_config = perform ReadFile({path: "{{root}}/.ssh/config", offset: 0, limit: 20})
let read_env_eyg = perform ReadFile({path: "{{root}}/.env.eyg", offset: 0, limit: 20})
let read_id_rsa_outside = perform ReadFile({path: "{{root}}/ordinary/id_rsa", offset: 0, limit: 20})
let read_file_named_secrets = perform ReadFile({path: "{{root}}/ordinary/secrets", offset: 0, limit: 20})
let rows = [
  {label: "read ordinary/nested/file.txt", answer: landed(read_ordinary)},
  {label: "write ordinary/nested/new.txt", answer: landed(write_ordinary)},
  {label: "read secrets/id_rsa", answer: landed(read_in_secrets)},
  {label: "write secrets/planted", answer: landed(write_in_secrets)},
  {label: "append secrets/id_rsa", answer: landed(append_in_secrets)},
  {label: "delete secrets/id_rsa", answer: landed(delete_in_secrets)},
  {label: "mkdir secrets/sub", answer: landed(mkdir_in_secrets)},
  {label: "list secrets", answer: landed(list_in_secrets)},
  {label: "search rooted at secrets", answer: landed(search_in_secrets)},
  {label: "search rooted at the root itself", answer: landed(search_from_root)},
  {label: "read .ssh/config", answer: landed(read_ssh_config)},
  {label: "read .env.eyg", answer: landed(read_env_eyg)},
  {label: "read ordinary/id_rsa (the bound: a secret-shaped name)", answer: landed(read_id_rsa_outside)},
  {label: "read ordinary/secrets (the cost: a file named like the directory)", answer: landed(read_file_named_secrets)}
]
perform StandardOut(!list_fold(rows, "hidden-name probe", (row, acc) -> {
  !string_append(!string_append(acc, "\n"), !string_append(!string_append(row.label, ": "), row.answer))
}))
