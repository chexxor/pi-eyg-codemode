// The secret rule: a file effect aimed at a `.env.eyg` is refused even when the
// path sits under a root the policy otherwise allows. Run it with
// `node bin/agent/refusal-probe.mjs --program test/fixtures/secret-probe.eyg --inside-roots`.
// The file it names does not have to exist: the rule answers before the host is asked.
let secret = perform ReadFile({path: "{{root}}/.env.eyg", offset: 0, limit: 40})
match secret {
  Error(why) -> { perform StandardOut(why) }
  Ok(_) -> { perform StandardOut("A SECRET FILE WAS READ") }
}
