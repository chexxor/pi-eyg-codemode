// One effect, asked for under whatever policy is loaded, and its answer printed.
// Under a preset that refuses writes this prints the refusal; nothing is written.
let r = perform WriteFile({path: "eyg-probe-refused.txt", contents: !string_to_binary("x")})
match r {
  Error(m) -> { perform StandardOut(m) }
  | (o) -> { perform StandardOut("performed and wrote a file") }
}
